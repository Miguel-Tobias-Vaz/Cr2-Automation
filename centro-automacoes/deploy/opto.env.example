# Copie para opto.env e ajuste. Não commite senhas reais.
# systemctl edit não necessário — EnvironmentFile aponta aqui.

OPTO_MAX_JOBS=5
OPTO_MAX_QUEUE=40
OPTO_SUBPROCESS=1
OPTO_JOB_TIMEOUT_S=21600

# Downloads paralelos por job (PDFs/documentos). 1 = sequencial; 4–6 = VPS com folga
# Limite de arquivos/tamanho ao compactar pastas para download (ZIP).
OPTO_MAX_ZIP_FILES=50000
OPTO_MAX_ZIP_MB=2048
OPTO_DOWNLOAD_WORKERS=6

# Tamanho de pasta: listagem rápida; front busca depois (folder-size)
OPTO_FOLDER_SIZE=1
OPTO_FOLDER_SIZE_ON_LIST=0
OPTO_FOLDER_SIZE_MAX_FILES=25000

# Download em lotes — cada subpasta (licitação/ano) fica inteira no lote
OPTO_ZIP_LOTE_MB=2048
OPTO_DL_PREBUILD=1
OPTO_DL_CACHE_TTL_S=86400

# Host/porta interna (Nginx faz proxy)
OPTO_BIND_HOST=127.0.0.1
OPTO_BIND_PORT=8765

# --- Auth (Supabase recomendado) ---
# Para desligar login por completo: OPTO_AUTH=off
# OPTO_AUTH=off

# Supabase — preencha URL e anon key (Project Settings → API)
OPTO_SUPABASE_URL=https://SEU-PROJETO.supabase.co
OPTO_SUPABASE_ANON_KEY=SUA_ANON_PUBLIC_KEY

# Painel Admin: e-mail(s) com acesso ao admin (separados por vírgula)
OPTO_PRINCIPAL_ADMIN=seu@email.com

# CORS — origem do painel (HTTPS). Vários domínios: separados por vírgula.
# OPTO_CORS_ORIGINS=https://seu-dominio.com

# --- Login local (alternativa sem Supabase) ---
# OPTO_USERS=admin:TROQUE_ESTA_SENHA:admin

# Upload (MB)
OPTO_MAX_UPLOAD_MB=150

# Jobs concluídos recentes no disco (banner download após restart)
OPTO_COMPLETED_TTL_S=7200

# Heartbeat subprocess Playwright — falha se sem log por N segundos
OPTO_WORKER_HEARTBEAT_S=180

# TCM-PA: Cloudflare bloqueia requests da VPS — força Playwright desde o início
OPTO_TCM_PLAYWRIGHT=1
