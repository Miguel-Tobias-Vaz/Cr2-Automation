# ============================================================
# VPS / PRODUCAO  —  NAO use o opto.env do PC local.
#
# Na VPS:
#   cp centro-automacoes/deploy/opto.env.example \
#      centro-automacoes/deploy/opto.env
#   nano centro-automacoes/deploy/opto.env
#
# NUNCA coloque URL/chave reais neste .example (ele vai para o Git).
# ============================================================

OPTO_LOCAL=0
# VPS sempre exige login. OPTO_AUTH=off é ignorado aqui (só vale no PC local).
# Sem URL/chave do Supabase (ou OPTO_USERS) o serviço recusa iniciar.

OPTO_SUPABASE_URL=https://SEU-PROJETO.supabase.co
OPTO_SUPABASE_ANON_KEY=SUA_ANON_PUBLIC_KEY
OPTO_PRINCIPAL_ADMIN=seu@email.com
OPTO_CORS_ORIGINS=https://seu-dominio.com
# Ollama só na própria VPS (o painel ignora URL de Ollama enviada pelo usuário).
# OPTO_OLLAMA_URL=http://127.0.0.1:11434

OPTO_MAX_JOBS=5
OPTO_MAX_QUEUE=40
OPTO_SUBPROCESS=1
OPTO_JOB_TIMEOUT_S=21600

OPTO_LICITACAO_WORKERS=10
OPTO_DOWNLOAD_WORKERS=6

OPTO_MAX_UPLOAD_MB=150
OPTO_MAX_ZIP_FILES=50000
OPTO_MAX_ZIP_MB=2048
OPTO_ZIP_LOTE_MB=2048
OPTO_DL_PREBUILD=1
OPTO_DL_CACHE_TTL_S=86400
OPTO_FOLDER_SIZE=1
OPTO_FOLDER_SIZE_ON_LIST=0
OPTO_FOLDER_SIZE_MAX_FILES=25000

OPTO_BIND_HOST=127.0.0.1
OPTO_BIND_PORT=8765

OPTO_COMPLETED_TTL_S=7200
OPTO_WORKER_HEARTBEAT_S=180
