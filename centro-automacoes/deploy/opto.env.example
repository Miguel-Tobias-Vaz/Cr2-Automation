# Copie para opto.env e ajuste. Não commite senhas reais.
# systemctl edit não necessário — EnvironmentFile aponta aqui.

OPTO_MAX_JOBS=2
OPTO_MAX_QUEUE=20
OPTO_SUBPROCESS=1
OPTO_JOB_TIMEOUT_S=21600

# Host/porta interna (Nginx faz proxy)
OPTO_BIND_HOST=127.0.0.1
OPTO_BIND_PORT=8765

# --- Supabase Auth (login por e-mail) — preferido na VPS ---
# Se preenchido, OPTO_USERS é ignorado para login.
# profiles: role admin|editor (editor = usuário comum), ativo=true/false
OPTO_SUPABASE_URL=https://SEU-PROJETO.supabase.co
OPTO_SUPABASE_ANON_KEY=SUA_ANON_PUBLIC_KEY

# --- Login local (alternativa sem Supabase) ---
# OPTO_USERS=admin:TROQUE_ESTA_SENHA:admin

# Upload (MB)
OPTO_MAX_UPLOAD_MB=150
